{"name": "harvestajo", "version": "0.1.0", "private": true, "description": "Plant together. Harvest together. Trustless rotating savings circles on Stellar.", "license": "MIT", "workspaces": ["packages/*", "sdk", "apps/*"], "scripts": {"build": "turbo run build", "dev": "turbo run dev", "lint": "turbo run lint", "clean": "turbo run clean", "build:contracts": "cargo build --manifest-path contracts/Cargo.toml --release --target wasm32-unknown-unknown", "test:contracts": "cargo test --manifest-path contracts/Cargo.toml", "format:contracts": "cargo fmt --manifest-path contracts/Cargo.toml --all"}, "devDependencies": {"turbo": "^2.3.0", "typescript": "^5.6.0"}, "packageManager": "npm@10.9.0"}